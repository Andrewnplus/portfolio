---
import Base from '../../layouts/Base.astro';
import { workCases } from '../../data/workCases';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="Case studies — Andrew Yang"
  description="Six production case studies from owning a solar-monitoring ingest pipeline: performance, async design, broker reliability, vendor onboarding, migration, KPIs."
>
  <h1>Case studies</h1>
  <p class="lede">
    Six production stories from three-plus years owning a solar-monitoring
    ingest pipeline. Internal system names are abstracted; the architecture and
    the numbers are real. Each write-up opens with a diagram — the detail behind
    it is a conversation, not a page.
  </p>

  <div class="case-list">
    {
      workCases.map((c) =>
        c.slug ? (
          <a class="card" href={`${base}/work/${c.slug}/`}>
            <span class="tag">{c.tag}</span>
            <h3>{c.title}</h3>
            <p>{c.teaser}</p>
          </a>
        ) : (
          <div class="card">
            <span class="tag">{c.tag}</span>
            <h3>{c.title}</h3>
            <p>{c.teaser}</p>
            <p class="muted" style="margin-top:0.5rem;font-size:0.8rem;">Write-up in progress</p>
          </div>
        ),
      )
    }
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import { demos, demoList } from '../../data/demos';
import { inWords } from '../../data/numberWords';

const count = inWords(demos.length, true);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="Demos — Andrew Yang"
  description={`${count} systems running right now: ${demoList()}.`}
>
  <h1>{count} systems that are running right now</h1>
  <p class="lede">
    Case studies are claims about the past; these are systems you can check
    today. Both are small enough for one operator and real enough to break —
    which is the point. Each page is a diagram, the decisions I would defend,
    and what each kind of reader tends to care about.
  </p>

  <div class="case-list">
    {
      demos.map((d) => (
        <a class="card" href={`${base}/demo/${d.slug}/`}>
          <span class="tag">{d.tag}</span>
          <h3>{d.title}</h3>
          <p>{d.teaser}</p>
        </a>
      ))
    }
  </div>

  <div class="callout">
    <p>
      <strong>Why these pages stay shallow on purpose.</strong> Configuration
      values, queue names, prompts and schemas change every month; the shape of
      the system and the reasons behind it do not. So the pages here carry the
      diagram and the trade-offs, and the implementation is something I would
      rather open in front of you — screen-shared, with the failure cases —
      than freeze into a page that quietly goes stale.
    </p>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import { facts } from '../data/facts';
import { labCases } from '../data/labCases';
import { demos, demoList } from '../data/demos';
import { inWords } from '../data/numberWords';
import { roles, contact } from '../data/roles';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
// 兩個數量都由清單長度衍生：加一篇 lab 或一個 demo 不必記得回來改句子。
const labCount = inWords(labCases.length, true);
const demoCount = inWords(demos.length);
---

<Base
  title="Andrew Yang — Backend Engineer"
  description={`Backend engineer: vendor API ingestion, message queues and KPI services on a solar-monitoring platform — plus a knowledge platform and ${demoCount} live demo systems.`}
>
  <h1>Backend engineer who owns data pipelines end-to-end.</h1>
  <p class="lede">
    From vendor API ingestion through message queues to KPI calculation services —
    and everything that repeats gets automated. Three years and counting as the
    de-facto owner of a solar-monitoring ingest pipeline
    (Kotlin · PHP · RabbitMQ · MySQL · Kubernetes).
  </p>

  <div class="callout">
    <p>
      <strong>I am looking for my next role</strong> — backend, full-stack or
      forward-deployed. Same work, three different first questions, so there are
      three reading orders through the same evidence:
    </p>
    <p class="roles">
      {
        roles.map((r, i) => (
          <>
            {i > 0 && <> · </>}
            <a href={`${base}/for/${r.slug}/`}>{r.label}</a>
          </>
        ))
      }
    </p>
    <p class="muted">
      Nothing on those pages is written twice — they select and order the pages
      below, and say why each one answers that reader's question. Reach me at{' '}
      <a href={`mailto:${contact.email}`}>{contact.email}</a>.
    </p>
  </div>

  <div class="stats">
    <div class="stat"><span class="n">{facts.yearsOwning}+ yrs</span><span class="d">ingest-pipeline de-facto owner, cross-stack root-cause work</span></div>
    <div class="stat"><span class="n">{facts.vendorApis}+</span><span class="d">third-party vendor APIs onboarded end-to-end, each across 6 repositories</span></div>
    <div class="stat"><span class="n">925 → 151 req/s</span><span class="d">hot-path request count −84% — then re-scoped with service-time analysis</span></div>
    <div class="stat"><span class="n">{facts.ticketsResolved}+</span><span class="d">tickets resolved, with the yearly volume roughly doubling</span></div>
    <div class="stat"><span class="n">{facts.repoCount}+</span><span class="d">repos in a personal knowledge platform under automated governance</span></div>
  </div>

  <div class="cards">
    <a class="card" href={`${base}/work/`}>
      <h3>Case studies</h3>
      <p>Six production stories: a site-wide outage turned into the right metric, a million-datapoint export queue-ified, a broker upgrade pre-empted.</p>
    </a>
    <a class="card" href={`${base}/platform/`}>
      <h3>Knowledge platform</h3>
      <p>{facts.repoCount}+ repositories, one owner: fleet governance with convention plugins, automated dependency policy, and an AI-assisted content pipeline.</p>
    </a>
    <a class="card" href={`${base}/lab/`}>
      <h3>The lab — design evolution</h3>
      <p>{labCount} stories of the same ideas evolving across generations of my own systems — from async pipelines and fleet governance to judgment calls, status lights that have to earn their green, and alerts that investigate themselves.</p>
    </a>
    <a class="card" href={`${base}/demo/`}>
      <h3>Live demos — {demoCount} running systems</h3>
      <p>{demoList().charAt(0).toUpperCase() + demoList().slice(1)}. All running now.</p>
    </a>
    <a class="card" href={`${base}/timeline/`}>
      <h3>Twelve days in July</h3>
      <p>A dated log of one migration: a hand-run machine became a declared one — every cutover dual-run first, every replaced component deleted the same day, every drill run twice.</p>
    </a>
    <a class="card" href={`${base}/about/`}>
      <h3>About</h3>
      <p>Background, technical range, and how to reach me.</p>
    </a>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import { labCases } from '../../data/labCases';
import { inWords } from '../../data/numberWords';

const count = inWords(labCases.length, true);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="Lab — Andrew Yang"
  description={`${count} stories of the same engineering ideas evolving across generations of my own systems — from async pipelines and fleet-scale build conventions to subtraction, earned green, and alerts that investigate themselves.`}
>
  <h1>The lab: how my designs evolve</h1>
  <p class="lede">
    My personal platform is where I test what I believe about engineering. The
    moat here is not any single technology — it is the method: one source of
    truth per fact, machine-enforced; silent failure modes hunted down until
    each has a voice; decisions recorded with the criteria that would change
    them. These stories show the same ideas evolving across generations of
    systems, each generation forced by a real failure of the last.
  </p>

  <div class="case-list">
    {
      labCases.map((c) => (
        <a class="card" href={`${base}/lab/${c.slug}/`}>
          <span class="tag">{c.tag}</span>
          <h3>{c.title}</h3>
          <p>{c.teaser}</p>
        </a>
      ))
    }
  </div>
</Base>

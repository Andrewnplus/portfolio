---
import Base from '../layouts/Base.astro';
import { facts } from '../data/facts';
import { demos, demoList } from '../data/demos';
import { inWords } from '../data/numberWords';
import { roles, contact } from '../data/roles';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="About — Andrew Yang"
  description="Background, technical range and contact details for Andrew Yang — a backend engineer working where data pipelines, message queues and domain modeling meet."
>
  <h1>About</h1>
  <p class="lede">
    Backend engineer at meteocontrol (solar-monitoring platform), based in Germany.
    I work where data pipelines, message queues, and domain modeling meet — and I
    automate anything I have to do twice.
  </p>

  <h2>What I do at work</h2>
  <ul class="clean">
    <li>
      <strong>Own the vendor-integration platform</strong> for a solar-monitoring
      ingest pipeline: {facts.vendorApis}+ third-party vendor APIs onboarded end-to-end, each spanning
      six repositories from parser to OpenAPI contract, plus feasibility spikes that
      turned stalled go/no-go decisions into concrete estimates.
    </li>
    <li>
      <strong>Turn incidents into architecture.</strong> A site-wide performance
      outage became a profiling exercise: request count on the hot path cut 84%
      (925 → 151 req/s) — and then a service-time analysis that corrected my own
      first conclusion about where the real bottleneck was.
    </li>
    <li>
      <strong>Build calculation services from physics to production:</strong> six
      yield-loss models and the platform's first device-level KPIs, each covering
      OpenAPI spec, database schema, Kotlin service, and the calculation pipeline.
    </li>
    <li>
      <strong>Keep production honest:</strong> 100+ cross-stack root-cause
      investigations (ingestion, timezones, vendor mappings, curtailment
      attribution), codified into runbooks the team actually reuses.
    </li>
  </ul>

  <h2>Technical range</h2>
  <p>
    <strong>Daily drivers:</strong> Kotlin (Ktor, Exposed, Gradle), PHP 8, RabbitMQ,
    MySQL/MariaDB at measurement-data scale, Redis, OpenAPI spec-first workflows.<br />
    <strong>Operations:</strong> Kubernetes, Docker, Prometheus/Grafana, CI/CD
    (TeamCity), PostgreSQL on personal infrastructure.
  </p>

  <h2>Outside work</h2>
  <p>
    I run a <a href={`${base}/platform/`}>{facts.repoCount}-repository knowledge platform</a> — book notes,
    handbooks, and topic sites — governed by the same engineering discipline I use
    professionally, and <a href={`${base}/demo/`}>{inWords(demos.length)} live systems</a>{' '}
    — {demoList()} — that put my reliability claims where anyone can check them.
  </p>

  <h2>What I'm looking for</h2>
  <p>
    My next role: <strong>backend, full-stack or forward-deployed engineering</strong>.
    Those are three different first questions rather than three different
    résumés, so each has its own reading order through the same evidence —{' '}
    {
      roles.map((r, i) => (
        <>
          {i > 0 && <> · </>}
          <a href={`${base}/for/${r.slug}/`}>{r.label}</a>
        </>
      ))
    }.
  </p>
  {
    (contact.arrangement || contact.availability) && (
      <p>
        {[contact.arrangement, contact.availability, contact.timezone]
          .filter(Boolean)
          .join(' · ')}.
      </p>
    )
  }

  <h2>Contact</h2>
  <p>
    <a href={contact.github}>{contact.github.replace('https://', '')}</a> ·
    <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
    <span class="muted">
      Email is the fastest route and I answer it. A PDF résumé exists on
      request, but the case studies here are the canonical version — they say
      more than a PDF can, and they are the thing I would rather be judged on.
    </span>
  </p>
</Base>

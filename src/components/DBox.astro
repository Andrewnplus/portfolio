---
// A labelled box inside a <Diagram>. Default size 230×60 is the shared grid
// unit; three of them at x = 10 / 335 / 660 fill one row of a 920-wide canvas.
// Keep `sub` lines under ~38 characters at the default width — they are not
// wrapped, and an overflowing label is worse than a shorter one.
interface Props {
  x: number;
  y: number;
  w?: number;
  h?: number;
  title: string;
  sub?: string;
  sub2?: string;
  /** Accent styling: the one box the reader should look at first. */
  accent?: boolean;
  /** Dashed border: a side path, not the happy path. */
  dashed?: boolean;
}
const { x, y, w = 230, h = 60, title, sub, sub2, accent = false, dashed = false } = Astro.props;
const cx = x + w / 2;
const ty = sub ? y + 22 : y + h / 2 + 4.5;
---

<rect
  class={accent ? 'box key' : 'box'}
  x={x}
  y={y}
  width={w}
  height={h}
  rx="8"
  stroke-dasharray={dashed ? '5 4' : undefined}
/>
<text class="t" x={cx} y={ty} text-anchor="middle">{title}</text>
{sub && <text class="s" x={cx} y={y + 39} text-anchor="middle">{sub}</text>}
{sub2 && <text class="s" x={cx} y={y + 53} text-anchor="middle">{sub2}</text>}

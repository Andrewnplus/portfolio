---
interface Props {
  viewBox: string;
  alt: string;
  caption: string;
}
const { viewBox, alt, caption } = Astro.props;
---

<figure class="diagram-figure">
  <div class="diagram">
    <svg viewBox={viewBox} role="img" aria-labelledby="d-title">
      <title id="d-title">{alt}</title>
      <defs>
        <marker
          id="d-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path class="ah" d="M0,0 L10,5 L0,10 z" />
        </marker>
      </defs>
      <slot />
    </svg>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

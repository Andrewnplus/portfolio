---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Andrew Yang — backend engineer. Data pipelines, message queues, KPI services, and large-scale automation.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname;
const current = (p: string) => (path === `${base}${p}` || path === `${base}${p}/` ? 'page' : undefined);

const canonical = new URL(path, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrew Yang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="wrap">
      <nav class="site">
        <a class="brand" href={`${base}/`}>Andrew Yang</a>
        <a href={`${base}/work/`} aria-current={current('/work')}>Work</a>
        <a href={`${base}/platform/`} aria-current={current('/platform')}>Platform</a>
        <a href={`${base}/lab/`} aria-current={current('/lab')}>Lab</a>
        <a href={`${base}/demo/`} aria-current={current('/demo')}>Demos</a>
        <a href={`${base}/about/`} aria-current={current('/about')}>About</a>
      </nav>
      <main>
        <slot />
      </main>
      <footer class="site">
        <span>© {new Date().getFullYear()} Andrew Yang · </span>
        <a href="https://github.com/Andrewnplus">GitHub</a>
        {' · '}
        <a href="mailto:andrew.nplus@gmail.com">Email</a>
      </footer>
    </div>
  </body>
</html>
